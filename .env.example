# =====================================================================
# ADEK TATU BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# =====================================================================
# Copy this file to .env and configure real values.
# NEVER commit the actual .env file or real secrets to version control.
# =====================================================================

# Server Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Proxy & Network Configuration
# Set to 'true', '1' (for 1 reverse proxy hop like cPanel/Passenger/Nginx), or proxy IP/subnet
TRUST_PROXY=false

# PostgreSQL Database (e.g., cPanel PostgreSQL database instance)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://adek_user:replace_with_secure_password@127.0.0.1:5432/adek_db
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Test Database URL (Used by integration tests - NEVER use production URL)
TEST_DATABASE_URL=postgresql://adek_user:replace_with_secure_password@127.0.0.1:5432/adek_test_db

# Frontend CORS Origin(s) (Comma-separated if multiple, e.g. https://adek.ke,https://api.adek.ke)
# NEVER use wildcard '*' with credentials in production
FRONTEND_ORIGIN=https://adek.ke

# Admin Session & Cookies
SESSION_COOKIE_NAME=adek_admin_session
SESSION_TTL_HOURS=12
# Options: 'lax' (recommended for subdomains/same-site), 'strict', or 'none' (requires HTTPS/secure: true)
COOKIE_SAME_SITE=lax
# Optional explicit boolean override; defaults to true in production
COOKIE_SECURE=true

# Cryptographic Keys (Each MUST be an independent, 32-byte / 64-hex character secret)
# Generate each key independently:
# Linux/macOS: openssl rand -hex 32
# Node.js:     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_generated_64_hex_chars_session_secret
DATA_ENCRYPTION_KEY=replace_with_generated_64_hex_chars_encryption_key
DATA_HMAC_KEY=replace_with_generated_64_hex_chars_hmac_key
TOTP_ENCRYPTION_KEY=replace_with_generated_64_hex_chars_totp_key

# OpenAPI / Swagger Documentation (Disabled by default in production; set to 'true' only if required)
ENABLE_SWAGGER=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
MEMBERSHIP_RATE_LIMIT_MAX=10
MEMBERSHIP_RATE_LIMIT_WINDOW_MS=60000
