{
  "name": "adek-tatu-backend",
  "version": "1.0.0",
  "description": "ADEK TATU Official Website Backend Service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "admin:reset-mfa": "tsx scripts/reset-admin-mfa.ts",
    "admin:revoke-sessions": "tsx scripts/revoke-admin-sessions.ts",
    "admin:disable": "tsx scripts/disable-admin.ts",
    "admin:enable": "tsx scripts/enable-admin.ts",
    "smoke": "tsx scripts/smoke-public.ts",
    "smoke:admin": "tsx scripts/smoke-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "otpauth": "^9.3.6",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
